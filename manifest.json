{
  "manifest_version": 3,
  "name": "Meeting Audio Transcriber (Whisper & Hermes)",
  "version": "1.0.0",
  "description": "บันทึกเสียงประชุมจากแท็บและไมค์ ถอดความด้วย Whisper API ส่งเข้า Hermes-Agent อัตโนมัติ",
  "permissions": [
    "tabCapture",
    "activeTab",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://api.openai.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
